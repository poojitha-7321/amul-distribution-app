# Copy to server/.env (local) or set in your host's dashboard (production).
NODE_ENV=development
PORT=4000
# Local dev database started by `npm run dev:db`
DATABASE_URL=postgres://postgres:postgres@localhost:54329/amul
# Set true for hosted databases that require TLS (Neon, Supabase, Render)
DATABASE_SSL=false
# REQUIRED in production, 32+ random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me
SESSION_HOURS=12
APP_TIMEZONE=Asia/Kolkata
# Production first-admin bootstrap (used by `npm run seed`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional in production: load the sample milk/curd catalogue / demo retailers
SEED_SAMPLE_CATALOG=false
SEED_DEMO=false

# Web Push (generate once:  npx web-push generate-vapid-keys). Without these, push is simply disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
